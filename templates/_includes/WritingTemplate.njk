<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico?">
    <link href="/style.css" rel="stylesheet" type="text/css" media="all">
    <link href="/emote.css" rel="stylesheet" type="text/css" media="all">
    <link href="/oc/fic.css" rel="stylesheet" type="text/css" media="all">
  </head>
 <body>
  <nav>
  <a href="/sitemap.html" style="--svg:url(/assets/map.svg)"></a>
      <a href="/index.html" style="--svg:url(/assets/home.svg)"></a>
      <a href="/oc/index.html">OC index</a>
      <a href="/oc/UtSS/index.html">UtSS</a>
      <a href="/oc/UtSS/story/index.html">Back</a>
    </nav>
  {% if chapters %}
  <div class="blognav">
  {% set previousPost = collections[ title | underscore ] | getPreviousCollectionItem %}
  {% set nextPost = collections[ title | underscore ] | getNextCollectionItem %}
      {% if previousPost %}<a href="{{ previousPost.url }}">{% endif %}<span>⭠ Previous</span>{% if previousPost %}</a>{% endif %}
        <a href="index.html"><span>Chapter Select</span></a>
        {% if nextPost %}<a href="{{ nextPost.url }}">{% endif %}<span>Next ⭢</span>{% if nextPost %}</a>{% endif %}
  </div>
  {% endif %}
  <main>
    <section class="wide">
      <article><h1>{{ title }}</h1>
      <div class="inner">
        <div class="text">
          <p class="tags">Tags: {% for tag in WritingTags %}<u>{{ tag }}</u>{% endfor %}</p>
          {% if subtitle %}<h2>{{ subtitle | safe }}</h2>{% endif %}
          <p>{{ desc | safe }}</p>
          {% if authornotes %}
          <hr>
          <h2>Author Notes:</h2>
          {{ authornotes | safe }}
          {% endif %}
          {% if chapters %}
          <hr>
          <h2>Chapter select:</h2>
          <ul>
          {% for chaps in collections[ title | underscore ] %}
            <li{% if page.url == chaps.url %} aria-current="page"{% endif %}>{% if page.url != chaps.url %}<a href="{{ chaps.url }}">{% endif %}{{ chaps.data.subtitle | safe }}{% if page.url != chaps.url %}</a>{% endif %}</li>
          {% endfor %}
          </ul>
          {% endif %}
        </div>
        <hr>
        <p class="date">Words: {{ content | wordCount }} | Written in: {{ WritingDate }}</p>
      </div>
    </article>
      <article>
        <div class="inner">
        {{ content | safe }}
        <hr>
      </div>
    </article>
</section>
</main>
</body>
</html>